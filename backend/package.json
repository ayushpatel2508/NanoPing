{
  "name": "ping-website",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "npx prisma generate && tsc",
    "dev": "nodemon --exec tsx src/index.ts",
    "migrate:create": "node-pg-migrate --migrations-dir src/migrations --migration-file-language ts create",
    "migrate:up": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate --migrations-dir src/migrations up",
    "migrate:down": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate --migrations-dir src/migrations down",
    "migrate:up:prod": "node node_modules/node-pg-migrate/bin/node-pg-migrate --migrations-dir dist/migrations up",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "prisma:pull": "npx prisma db pull",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bull-board/api": "6.20.6",
    "@bull-board/express": "6.20.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "dotenv-config": "^0.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3"
  }
}
